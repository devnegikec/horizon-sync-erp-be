# Development Environment Configuration
# This file is for local development only

# Application
APP_NAME=Identity Service
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (Identity Service's own database)
DATABASE_URL=postgresql://horizon_user:horizon_pass@localhost:5432/identity_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Security
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_ACCESS_TOKEN_EXPIRE_DAYS=30
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=90
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
PASSWORD_RESET_URL=http://localhost:4200/reset-password
INVITATION_URL=http://localhost:4200/accept-invitation

# Cookie Settings - Development (No HTTPS required)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true
COOKIE_DOMAIN=

# Email (for password reset notifications)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Identity Service
SMTP_VALIDATE_CERTS=false

# CORS - Allow localhost origins for development
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:4200
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=DEBUG
