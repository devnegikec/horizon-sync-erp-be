# Application
APP_NAME=Identity Service
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (Identity Service's own database)
DATABASE_URL=postgresql://horizon_user:horizon_pass@postgres:5432/identity_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_ACCESS_TOKEN_EXPIRE_DAYS=30
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=90
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# Cookie Settings (for Remember Me feature)
# Development: COOKIE_SECURE=false, COOKIE_SAMESITE=lax
# Production: COOKIE_SECURE=true, COOKIE_SAMESITE=none (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true
COOKIE_DOMAIN=

# Email (for password reset notifications)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=devnegikec@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Identity Service

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# Core Service Integration
CORE_SERVICE_URL=http://localhost:8001
CORE_SERVICE_TIMEOUT=10
ENABLE_AUTO_CHART_CREATION=true
CHART_CREATION_RETRY_ATTEMPTS=3
