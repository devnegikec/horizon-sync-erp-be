{
  "info": {
    "name": "User Permissions API",
    "description": "Collection for testing user permissions endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get My Permissions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/users/me/permissions?organization_id={{organization_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "users", "me", "permissions"],
          "query": [
            {
              "key": "organization_id",
              "value": "{{organization_id}}",
              "description": "UUID of the organization"
            }
          ]
        },
        "description": "Get current user's permissions within an organization. Returns permissions, roles, and access status."
      },
      "response": [
        {
          "name": "Success Response",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me/permissions?organization_id={{organization_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me", "permissions"],
              "query": [
                {
                  "key": "organization_id",
                  "value": "{{organization_id}}"
                }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"user_id\": \"99999999-9999-9999-9999-999999999999\",\n  \"organization_id\": \"11111111-1111-1111-1111-111111111111\",\n  \"permissions\": [\n    \"user.read\",\n    \"user.create\",\n    \"user.update\",\n    \"item.read\",\n    \"item.create\",\n    \"invoice.read\"\n  ],\n  \"roles\": [\n    \"Organization Administrator\"\n  ],\n  \"has_access\": true\n}"
        },
        {
          "name": "No Access Response",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me/permissions?organization_id={{organization_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me", "permissions"],
              "query": [
                {
                  "key": "organization_id",
                  "value": "{{organization_id}}"
                }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"user_id\": \"99999999-9999-9999-9999-999999999999\",\n  \"organization_id\": \"22222222-2222-2222-2222-222222222222\",\n  \"permissions\": [],\n  \"roles\": [],\n  \"has_access\": false\n}"
        }
      ]
    },
    {
      "name": "Get User Permissions (Admin)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/users/:user_id/permissions?organization_id={{organization_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "users", ":user_id", "permissions"],
          "query": [
            {
              "key": "organization_id",
              "value": "{{organization_id}}",
              "description": "UUID of the organization"
            }
          ],
          "variable": [
            {
              "key": "user_id",
              "value": "{{target_user_id}}",
              "description": "UUID of the user to check permissions for"
            }
          ]
        },
        "description": "Get a specific user's permissions within an organization. Requires user.read permission."
      },
      "response": [
        {
          "name": "Success Response",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/:user_id/permissions?organization_id={{organization_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", ":user_id", "permissions"],
              "query": [
                {
                  "key": "organization_id",
                  "value": "{{organization_id}}"
                }
              ],
              "variable": [
                {
                  "key": "user_id",
                  "value": "{{target_user_id}}"
                }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"user_id\": \"88888888-8888-8888-8888-888888888888\",\n  \"organization_id\": \"11111111-1111-1111-1111-111111111111\",\n  \"permissions\": [\n    \"user.read\",\n    \"item.read\"\n  ],\n  \"roles\": [\n    \"User\"\n  ],\n  \"has_access\": true\n}"
        },
        {
          "name": "Forbidden - No Permission",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/:user_id/permissions?organization_id={{organization_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", ":user_id", "permissions"],
              "query": [
                {
                  "key": "organization_id",
                  "value": "{{organization_id}}"
                }
              ],
              "variable": [
                {
                  "key": "user_id",
                  "value": "{{target_user_id}}"
                }
              ]
            }
          },
          "status": "Forbidden",
          "code": 403,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"detail\": \"Missing required permission: user.read\"\n}"
        }
      ]
    },
    {
      "name": "Get My Permissions - Unauthorized",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/users/me/permissions?organization_id={{organization_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "users", "me", "permissions"],
          "query": [
            {
              "key": "organization_id",
              "value": "{{organization_id}}"
            }
          ]
        },
        "description": "Test endpoint without authentication token"
      },
      "response": [
        {
          "name": "Unauthorized Response",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me/permissions?organization_id={{organization_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me", "permissions"],
              "query": [
                {
                  "key": "organization_id",
                  "value": "{{organization_id}}"
                }
              ]
            }
          },
          "status": "Unauthorized",
          "code": 401,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"detail\": \"Not authenticated\"\n}"
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "your-access-token-here",
      "type": "string"
    },
    {
      "key": "organization_id",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "string"
    },
    {
      "key": "target_user_id",
      "value": "88888888-8888-8888-8888-888888888888",
      "type": "string"
    }
  ]
}
