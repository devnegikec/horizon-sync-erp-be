# Production Environment Configuration
# IMPORTANT: Update all values before deploying to production

# Application
APP_NAME=Identity Service
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000

# Database (Identity Service's own database)
# IMPORTANT: Use strong credentials in production
DATABASE_URL=postgresql://prod_user:CHANGE_THIS_PASSWORD@prod-db-host:5432/identity_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Security
# IMPORTANT: Generate a strong secret key (min 32 characters)
# You can generate one with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_ACCESS_TOKEN_EXPIRE_DAYS=30
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=90
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
PASSWORD_RESET_URL=https://yourdomain.com/reset-password
INVITATION_URL=https://yourdomain.com/accept-invitation

# Cookie Settings - Production (HTTPS required)
# IMPORTANT: Set COOKIE_SECURE=true in production
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_HTTPONLY=true
COOKIE_DOMAIN=.yourdomain.com

# Email (for password reset notifications)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Identity Service
SMTP_VALIDATE_CERTS=true

# CORS - Production domains only
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# Core Service Integration
# IMPORTANT: Update CORE_SERVICE_URL to your production Core Service URL
CORE_SERVICE_URL=http://core-service:8001
CORE_SERVICE_TIMEOUT=10
ENABLE_AUTO_CHART_CREATION=true
CHART_CREATION_RETRY_ATTEMPTS=3
