{
	"info": {
		"_postman_id": "purchase-order-api-collection",
		"name": "Purchase Order API",
		"description": "Complete API collection for testing Purchase Order endpoints with realistic data",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Create Purchase Order from RFQ",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 201) {",
							"    const response = pm.response.json();",
							"    pm.environment.set('purchase_order_id', response.id);",
							"    console.log('Purchase Order ID:', response.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}",
						"description": "JWT token from identity service"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"rfq_id\": \"{{rfq_id}}\",\n  \"party_id\": \"{{supplier_id}}\",\n  \"tax_rate\": 0.10,\n  \"discount_amount\": 0,\n  \"line_items\": [\n    {\n      \"item_id\": \"{{item_id_1}}\",\n      \"quantity\": 50,\n      \"unit_price\": 125.50\n    },\n    {\n      \"item_id\": \"{{item_id_2}}\",\n      \"quantity\": 25,\n      \"unit_price\": 450.00\n    }\n  ]\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/purchase-orders",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "purchase-orders"]
				},
				"description": "Create a new Purchase Order from an RFQ with supplier quotes"
			},
			"response": []
		},
		{
			"name": "2. Create Standalone Purchase Order",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 201) {",
							"    const response = pm.response.json();",
							"    pm.environment.set('purchase_order_id_2', response.id);",
							"    console.log('Purchase Order ID 2:', response.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"party_id\": \"{{supplier_id}}\",\n  \"tax_rate\": 0.08,\n  \"discount_amount\": 50.00,\n  \"line_items\": [\n    {\n      \"item_id\": \"{{item_id_3}}\",\n      \"quantity\": 100,\n      \"unit_price\": 15.75\n    },\n    {\n      \"item_id\": \"{{item_id_4}}\",\n      \"quantity\": 200,\n      \"unit_price\": 8.50\n    }\n  ]\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/purchase-orders",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "purchase-orders"]
				},
				"description": "Create a standalone Purchase Order without RFQ reference"
			},
			"response": []
		},
