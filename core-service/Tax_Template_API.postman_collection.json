							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Template is marked as default', function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response.is_default).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/tax-templates/{{tax_template_id_gst12}}/set-default",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "tax-templates", "{{tax_template_id_gst12}}", "set-default"]
				},
				"description": "Set a tax template as the default for its category"
			},
			"response": []
		},
		{
			"name": "9. Get Applicable Tax Template",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has template and source', function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response).to.have.property('template');",
							"    pm.expect(response).to.have.property('source');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/tax-templates/applicable?transaction_type=Sales&item_id={{item_id}}",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "tax-templates", "applicable"],
					"query": [
						{
							"key": "transaction_type",
							"value": "Sales"
						},
						{
							"key": "item_id",
							"value": "{{item_id}}"
						}
					]
				},
				"description": "Get the applicable tax template based on context (item, transaction type)"
			},
			"response": []
		},
		{
			"name": "10. Delete Tax Template",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 204', function () {",
							"    pm.response.to.have.status(204);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/tax-templates/{{tax_template_id_cess}}",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "tax-templates", "{{tax_template_id_cess}}"]
				},
				"description": "Soft delete a tax template (will fail if referenced by items or transactions)"
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8001",
			"type": "string"
		}
	]
}
