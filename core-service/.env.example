# Application
APP_NAME=Core Service
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8001

# Database (same as identity-service)
DATABASE_URL=postgresql://identity_user:identity_pass@postgres:5432/identity_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Security (must match identity-service for JWT validation)
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256

# Identity Service URL (for auth validation and permissions)
IDENTITY_SERVICE_URL=http://identity-service:8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
