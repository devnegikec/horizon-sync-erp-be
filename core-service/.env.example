# Application
APP_NAME=Core Service
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8001

# Database (core-service's own database)
DATABASE_URL=postgresql://horizon_user:horizon_pass@postgres:5432/core_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Identity Database (for seeding - to fetch org/user data)
IDENTITY_DATABASE_URL=postgresql://horizon_user:horizon_pass@postgres:5432/identity_db

# Security (must match identity-service for JWT validation)
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256

# Identity Service URL (for auth validation and permissions)
IDENTITY_SERVICE_URL=http://identity-service:8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# QR Code Configuration
# Domain used to construct QR verification URLs: https://{org_short_code}.{QR_DOMAIN}/g/...
QR_DOMAIN=verify.example.com
# Full base URL override (scheme+host). When set, replaces the QR_DOMAIN-based URL entirely.
# Example: QR_BASE_URL=https://app.horizonsync.com/verify
QR_BASE_URL=

# Logging
LOG_LEVEL=INFO
