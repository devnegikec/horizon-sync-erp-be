# Application
APP_NAME=Core Service
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0

# Server
HOST=0.0.0.0
PORT=8001

# Database (core-service's own database)
DATABASE_URL=postgresql://horizon_user:horizon_pass@postgres:5432/core_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Identity Database (for seeding - to fetch org/user data)
IDENTITY_DATABASE_URL=postgresql://horizon_user:horizon_pass@postgres:5432/identity_db

# Security (must match identity-service for JWT validation)
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256

# Identity Service URL (for auth validation and permissions)
IDENTITY_SERVICE_URL=http://identity-service:8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# QR signing and public verification
# Generate this once per environment and store it in a secret manager.
BRAND_KEY_ENCRYPTION_SECRET=
QR_DOMAIN=horizon.ciphercode.ai
# Optional full scheme + host override, useful for local or staging deployments.
QR_BASE_URL=

# QR short URL provider
QR_SHORTENER_ENABLED=true
QR_SHORTENER_URL=https://de5be4rdmboho.cloudfront.net/prod/
QR_SHORTENER_CDN_PREFIX=bwqr.me
QR_SHORTENER_TIMEOUT_SECONDS=10
QR_SHORTENER_MAX_RETRIES=3

# Durable QR block generation worker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_QR_QUEUE_NAME=qr-generation
CELERY_VISIBILITY_TIMEOUT_SECONDS=7200

# Private S3 storage for QR workbooks and Product images
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
AWS_S3_ENDPOINT_URL=
AWS_S3_PRESIGNED_EXPIRY_SECONDS=300
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Legacy GCS compatibility
GCS_BUCKET=
GCS_CREDENTIALS_PATH=

# Local development fallback when AWS_S3_BUCKET is empty
PRODUCT_IMAGE_UPLOAD_DIR=uploads/product-images
PRODUCT_IMAGE_MAX_BYTES=5242880

# Logging
LOG_LEVEL=INFO
