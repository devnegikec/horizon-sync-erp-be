# ===========================================
# Horizon Sync Backend - Environment Variables
# ===========================================
# Copy this file to .env and update values

# ===========================================
# Database (PostgreSQL Container)
# ===========================================
# Each service has its own database:
#   - identity_db: Identity Service (auth, users, orgs)
#   - core_db: Core Service (inventory, orders, billing)
DB_USER=horizon_user
DB_PASSWORD=horizon_pass
DB_NAME=postgres
DB_PORT=5432

# ===========================================
# Application
# ===========================================
DEBUG=false
ENVIRONMENT=development

# ===========================================
# Security (MUST be same across all services)
# ===========================================
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# ===========================================
# CORS (Frontend URLs)
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# ===========================================
# Email Configuration
# ===========================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Horizon Sync

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
