# ============================================================
# SnapDeploy — Environment Variables Reference
# ============================================================
#
# 🗄️  PostgreSQL → Neon (neon.tech)
#    Connection string format:
#    postgresql://<user>:<pass>@ep-xxx.us-east-2.aws.neon.tech/<dbname>?sslmode=require
#
# ⚡ Redis → Upstash (upstash.com)
#    Connection string format:
#    rediss://default:<password>@<host>:6379
#    (Note: rediss:// not redis:// — the extra 's' enables TLS)

# redis-cli --tls -u redis://default:gQAAAAAAAY4_AAIgcDJmZGZjMDc1MWE1MjU0MGNiOGRiZjZjNzI2MTMyNDRhNA@healthy-stallion-101951.upstash.io:6379
#
# For each service below, copy the env vars into the SnapDeploy
# dashboard when creating the app. Values marked <SET_ME> must be
# replaced with your actual Neon/Upstash/SnapDeploy URLs.
# ============================================================

# =============================================================================
#  1. IDENTITY SERVICE  |  snapdeploy/identity.Dockerfile  |  Port 8000
# =============================================================================
#
#  REQUIRED — service will not start without these:
#
DATABASE_URL=postgresql://neondb_owner:npg_eapZE46cCGrN@ep-spring-wind-as30nlz9-pooler.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# postgresql://<neon-user>:<neon-pass>@<neon-host>.neon.tech/identity_db?sslmode=require
SECRET_KEY=du3HcsZuMrCxpDdwP/NScOw8tZZBq9MXh3xdEuUH6b+AKJmfkSKKZ/Fk1xVw7JE8

#
#  OPTIONAL — sensible defaults are in the code, override as needed:
#
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=https://your-frontend-domain.com,https://identity-xxxxx.snapdeploy.dev,https://core-xxxxx.snapdeploy.dev
ACCESS_TOKEN_EXPIRE_MINUTES=4320
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_URL=https://your-frontend-domain.com/reset-password
INVITATION_URL=https://your-frontend-domain.com/accept-invitation
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

#
#  EMAIL (SMTP) — required for password reset, invitations:
#
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=<gmail-app-password>
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=HorizonSync

#
#  CORE SERVICE INTEGRATION — set AFTER Core is deployed:
#
CORE_SERVICE_URL=https://core-xxxxx.snapdeploy.dev
CORE_SERVICE_TIMEOUT=10
ENABLE_AUTO_CHART_CREATION=true
CHART_CREATION_RETRY_ATTEMPTS=3


# =============================================================================
#  2. CORE SERVICE  |  snapdeploy/core.Dockerfile  |  Port 8001
# =============================================================================
#
#  REQUIRED:
#
DATABASE_URL=postgresql://<neon-user>:<neon-pass>@<neon-host>.neon.tech/core_db?sslmode=require
SECRET_KEY=<same-key-as-identity-service>

#
#  OPTIONAL:
#
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=https://your-frontend-domain.com,https://identity-xxxxx.snapdeploy.dev,https://core-xxxxx.snapdeploy.dev,https://search-xxxxx.snapdeploy.dev

#
#  IDENTITY DATABASE (read-only — needed for user/org lookups):
#
IDENTITY_DATABASE_URL=postgresql://<neon-user>:<neon-pass>@<neon-host>.neon.tech/identity_db?sslmode=require

#
#  IDENTITY SERVICE — set AFTER Identity is deployed:
#
IDENTITY_SERVICE_URL=https://identity-xxxxx.snapdeploy.dev

#
#  REDIS (Upstash) — for search-sync events & caching:
#
REDIS_URL=rediss://default:<upstash-password>@<upstash-host>.upstash.io:6379
REDIS_STREAM_NAME=search:events
REDIS_WAREHOUSE_URL=rediss://default:<upstash-password>@<upstash-host>.upstash.io:6379/1
REDIS_WAREHOUSE_STREAM_NAME=warehouse:3d:events

#
#  EMAIL (SMTP):
#
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=<gmail-app-password>
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=HorizonSync


# =============================================================================
#  3. SEARCH SERVICE  |  snapdeploy/search.Dockerfile  |  Port 8002
# =============================================================================
#
#  REQUIRED:
#
DATABASE_URL=postgresql://<neon-user>:<neon-pass>@<neon-host>.neon.tech/search_db?sslmode=require
SECRET_KEY=<same-key-as-identity-service>

#
#  OPTIONAL:
#
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=https://your-frontend-domain.com,https://search-xxxxx.snapdeploy.dev,https://core-xxxxx.snapdeploy.dev

#
#  IDENTITY SERVICE — set AFTER Identity is deployed:
#
IDENTITY_SERVICE_URL=https://identity-xxxxx.snapdeploy.dev

#
#  CORE SERVICE — set AFTER Core is deployed:
#
CORE_SERVICE_URL=https://core-xxxxx.snapdeploy.dev

#
#  REDIS (Upstash) — for search cache:
#
REDIS_URL=rediss://default:<upstash-password>@<upstash-host>.upstash.io:6379
CACHE_TTL_SECONDS=300
SEARCH_MAX_RESULTS=1000
SEARCH_DEFAULT_PAGE_SIZE=20

#
#  SYNC SERVICE CREDENTIALS (user that exists in Identity Service):
#
SYNC_SERVICE_USERNAME=admin@example.com
SYNC_SERVICE_PASSWORD=<admin-password>
