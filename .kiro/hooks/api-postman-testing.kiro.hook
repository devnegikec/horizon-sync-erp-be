{
  "enabled": true,
  "name": "API Postman Testing",
  "description": "Monitors API source code changes in core-service and identity-service and automatically runs Postman collection tests to validate functionality",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "core-service/app/**/*.py",
      "identity-service/app/**/*.py",
      "core-service/requirements.txt",
      "identity-service/requirements.txt",
      "core-service/pyproject.toml",
      "identity-service/pyproject.toml",
      "docker-compose.yml",
      "*/docker-compose.*.yml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "API source code or configuration has been modified. Please retrieve the contents of the .postman.json file. If the file does not exist or is empty, create a Postman collection for the API. If it exists, get the collection ID and run the collection, showing me the results and propose fixes for any errors found."
  }
}
