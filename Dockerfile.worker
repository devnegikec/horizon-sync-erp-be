# Celery worker — no web server, no web healthcheck.
# Built from the repo root (same context as Dockerfile.core).
# Used for BOTH worker services in railway.toml:
#   - qr-worker   → --queues=qr-generation  (QR block generation)
#   - core-worker → --queues=core-tasks     (bulk put-away, reconciliation)
# The queue is resolved at runtime from CELERY_WORKER_QUEUES, defaulting to
# the QR queue; Railway overrides it per service via startCommand.

FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY core-service/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y \
    postgresql-client \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH

COPY core-service/ .

CMD celery -A app.celery_app:celery_app worker --loglevel=INFO --queues=${CELERY_WORKER_QUEUES:-qr-generation} --concurrency=2
