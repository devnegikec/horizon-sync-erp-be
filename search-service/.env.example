# Application
APP_NAME=Search Service
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8002

# Database (search-service's own database)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/search_db

# Security (must match identity-service for JWT validation)
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256

# Identity Service URL (for auth validation and permissions)
IDENTITY_SERVICE_URL=http://identity-service:8000

# Core Service URL (for entity data access)
CORE_SERVICE_URL=http://core-service:8001

# Redis Cache
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# CORS
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# Search Configuration
SEARCH_MAX_RESULTS=1000
SEARCH_DEFAULT_PAGE_SIZE=20
SEARCH_PERFORMANCE_TARGET_MS=500
