# =============================================================================
# Copy this file to `.sync.env` (same folder) and fill in your values.
# `.sync.env` is gitignored — never commit real credentials.
# =============================================================================

# --- Source databases (one profile per Railway Postgres) --------------------
# CORE
# CORE_SOURCE_DATABASE_URL=postgresql://postgres:PASSWORD@iriguchi.proxy.rlwy.net:39497/railway
# CORE_TARGET_DB=core_db

# IDENTITY
# IDENTITY_SOURCE_DATABASE_URL=postgresql://postgres:PASSWORD@iriguchi.proxy.rlwy.net:15540/railway
# IDENTITY_TARGET_DB=identity_db

# --- Local target Postgres container ----------------------------------------
# LOCAL_DB_USER=horizon_user
# LOCAL_DB_PASSWORD=horizon_pass
# LOCAL_DB_PORT=5432
# LOCAL_CONTAINER=horizon_postgres

# --- (optional) profiles synced by `./sync_local_db.sh all` -----------------
# SYNC_PROFILES="core identity"
