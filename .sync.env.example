# =============================================================================
# Copy this file to `.sync.env` (same folder) and fill in your values.
# `.sync.env` is gitignored — never commit real credentials.
# =============================================================================

# --- REQUIRED: Railway Postgres connection string ---------------------------
# Railway dashboard -> your project -> Postgres -> Connect -> "Public Network"
# Copy the full "postgresql://..." connection string here.
#
# NOTE: If you leave this empty AND the Railway CLI is installed + logged in,
# the sync script will open a `railway connect Postgres` tunnel automatically.
SOURCE_DATABASE_URL=

# --- Local target Postgres (matches docker-compose.yml defaults) ------------
# LOCAL_DB_USER=db_user
# LOCAL_DB_PASSWORD=db_pass
# LOCAL_DB_PORT=5432
# LOCAL_CONTAINER=horizon_postgres

# --- Railway plugin service name (for `railway connect`) --------------------
# RAILWAY_SERVICE=Postgres
